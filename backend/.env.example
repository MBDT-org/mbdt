# MBDT configuration.
#
# Copy this file to backend/.env and add ONE API key:
#
#     cp backend/.env.example backend/.env
#
# Then edit backend/.env. The key is read only from that file and is sent only
# to the gateway you select. backend/.env is git-ignored: never commit it.

# ---------------------------------------------------------------------------
# Gateway: requesty (default) or openrouter
# ---------------------------------------------------------------------------
# Both are OpenAI-compatible and cover stories, handwriting OCR, speech output
# and speech input. Leave this unset to use Requesty, or OpenRouter when only
# MBDT_OPENROUTER_API_KEY is set. If you add both keys, choose explicitly.
# MBDT_PROVIDER=requesty

# --- Requesty (https://requesty.ai) ---
# One key covers LLM, TTS and STT. Get one at https://app.requesty.ai/api-keys
MBDT_REQUESTY_API_KEY=sk-...
# EU residents can use https://router.eu.requesty.ai/v1
# MBDT_REQUESTY_BASE_URL=https://router.requesty.ai/v1

# --- OpenRouter (https://openrouter.ai) ---
# Get one at https://openrouter.ai/keys (starts with sk-or-v1-)
# MBDT_PROVIDER=openrouter
# MBDT_OPENROUTER_API_KEY=sk-or-v1-...
# MBDT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Models (provider/model ids as known by the selected gateway)
# ---------------------------------------------------------------------------
# Leave these unset to use the defaults for your gateway.
# Requesty defaults:  fireworks/deepseek-v4.1-flash-1017 (LLM and OCR),
#                     openai/whisper-1 (STT),
#                     deepinfra/ResembleAI/chatterbox-turbo (TTS)
# OpenRouter defaults: deepseek/deepseek-v4.1-flash-1017 (LLM and OCR),
#                      openai/whisper-large-v3 (STT),
#                      mistralai/voxtral-mini-tts-2603 (TTS)
# Model ids do not carry over between gateways.
# MBDT_LLM_MODEL=fireworks/deepseek-v4.1-flash-1017
# MBDT_OCR_MODEL=fireworks/deepseek-v4.1-flash-1017
# MBDT_STT_MODEL=openai/whisper-1

# --- TTS voice configuration ---
# MBDT_TTS_MODEL=deepinfra/ResembleAI/chatterbox-turbo
# Voice id understood by the provider. "default" = chatterbox built-in;
# OpenRouter's voxtral default is "en_paul_neutral"; OpenAI TTS models use
# alloy/ash/ballad/coral/echo/fable/onyx/nova/sage/shimmer/verse.
# Unknown ids silently fall back to the provider default.
# MBDT_TTS_VOICE=default
# Playback speed, 0.25-4.0 (empty/unset = provider default).
# Requesty defaults to 0.9; OpenRouter leaves it unset because some TTS models
# reject a non-default value.
# MBDT_TTS_SPEED=0.9
# Voice steering prompt — honoured by openai/gpt-4o-mini-tts, ignored by others.
# MBDT_TTS_INSTRUCTIONS=Speak clearly and warmly at a calm, unhurried pace, like a friendly teacher helping a young child learn to read.
# Audio container: mp3 | opus | aac | flac | wav | pcm.
# OpenRouter currently supports mp3 and pcm only.
# MBDT_TTS_FORMAT=mp3

# ---------------------------------------------------------------------------
# Storage / runtime
# ---------------------------------------------------------------------------
# MBDT_DB_PATH=mbdt.db
# MBDT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin password for demo tools (skip buttons, reset/skip-a-day). Seeds the
# stored hash on first use; afterwards change it in the Dashboard Admin tab.
MBDT_ADMIN_PASSWORD=change-me
